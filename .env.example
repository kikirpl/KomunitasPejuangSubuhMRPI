# Alamat situs setelah diterbitkan, tanpa garis miring di akhir (disarankan diisi).
# Dipakai agar gambar pratinjau tautan di WhatsApp dan media sosial tampil benar,
# dan sebagai dasar alamat balik masuk dengan Google.
# NEXT_PUBLIC_SITE_URL=https://alamat-situs-anda.id

# Alamat dasar API Al Quran Cloud (opsional, hanya dibaca di server oleh /api/ayat).
# Bawaan: https://api.alquran.cloud/v1
# QURAN_API_BASE=https://api.alquran.cloud/v1

# ---------------------------------------------------------------------------
# Panel Pengurus (/admin). Semua baris di bawah dikomentari: hapus tanda # lalu isi nilainya.
# Rahasia hanya diisi di variabel lingkungan Vercel atau di .env.local (berkas .env* tidak pernah di-commit).
# Penjelasan lengkap dan urutan langkahnya ada di README, bagian "Panel Pengurus".
# ---------------------------------------------------------------------------

# Database Neon: Vercel > Storage > Marketplace > Neon. Terisi otomatis saat dihubungkan ke proyek.
# DATABASE_URL=postgresql://contoh:contoh@host-contoh.neon.tech/namadb?sslmode=require

# Penyimpanan foto: Vercel > Storage > Blob, buat toko berakses Publik dan hubungkan ke proyek.
# Tokennya terisi otomatis oleh Vercel.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_contoh-diisi-otomatis-oleh-vercel
# Host publik toko itu (muncul di alamat foto), diisi manual lalu deploy ulang (dibaca saat build).
# BLOB_PUBLIC_HOST=id-toko-contoh.public.blob.vercel-storage.com

# Masuk dengan Google: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Alamat balik: {alamat-situs}/admin/auth/google/callback dan http://localhost:3000/admin/auth/google/callback
# AUTH_GOOGLE_ID=contoh-client-id.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=contoh-client-secret

# Rahasia sesi: 32 byte acak (paling sedikit 32 karakter). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SESSION_SECRET=contoh-ganti-dengan-hasil-perintah-di-atas

# Email pengurus yang boleh masuk, dipisah koma (huruf kecil). Mencabut akses: hapus emailnya, lalu deploy ulang.
# ADMIN_EMAILS=pengurus1@gmail.com,pengurus2@gmail.com

# Nomor WhatsApp pengelola web untuk tautan "Bantuan" di panel (awali 62, tanpa 0 dan tanpa +). Opsional;
# tanpa ini tautan Bantuan disembunyikan.
# ADMIN_HELP_WHATSAPP=6281234567890

# Hanya untuk di komputer sendiri: menjalankan panel tanpa database (data di memori, hilang saat server dimatikan).
# Ditolak otomatis bila dijalankan di Vercel.
# CONTENT_STORE=memory
